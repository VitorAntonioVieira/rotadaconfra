# Porta da aplicacao web
PORT=3000

# String de conexao PostgreSQL
DATABASE_URL=postgres://rota:rota_secret@db:5432/rota_da_confra

# Diretorio real no disco da VPS onde os arquivos do PostgreSQL serao gravados.
# Em producao na VPS, recomenda-se um caminho absoluto fora da pasta do repositorio,
# por exemplo: /var/lib/rota-da-confra/postgres
PGDATA_PATH=./data/postgres

# Codigo de acesso unico para colaboradores da SPS Group
ACCESS_CODE=confra2026

# Configuracao do ponto rapido "Escritorio SPS" (padrao: Matriz SJC)
SPS_OFFICE_LABEL=Escritorio SPS (Jardim Limoeiro, Sao Jose dos Campos - SP)
SPS_OFFICE_LAT=-23.2370
SPS_OFFICE_LNG=-45.9087
